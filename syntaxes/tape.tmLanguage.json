{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tape",
  "scopeName": "source.tape",
  "fileTypes": ["tape"],
  "patterns": [
    { "include": "#shebang" },
    { "include": "#section-divider" },
    { "include": "#box-divider" },
    { "include": "#comment" },
    { "include": "#entry-header" },
    { "include": "#roster-row" },
    { "include": "#edge-line" },
    { "include": "#field-line" }
  ],
  "repository": {
    "shebang": {
      "match": "^#!.*$",
      "name": "comment.line.shebang.tape"
    },
    "section-divider": {
      "match": "^# ── .* ──+$",
      "name": "markup.heading.section.tape"
    },
    "box-divider": {
      "match": "^# ═+$",
      "name": "markup.heading.box.tape"
    },
    "comment": {
      "match": "^#.*$",
      "name": "comment.line.number-sign.tape"
    },
    "entry-header": {
      "match": "^(@[SUATRHDKPILVXFNC?])\\s+(\\S+)(?:\\s+(.+?))?\\s+(::)\\s+(\\S+)(?:\\s+(\\[)([^\\]]+)(\\]))?\\s*$",
      "captures": {
        "1": { "name": "keyword.control.type.tape" },
        "2": { "name": "entity.name.event.tape" },
        "3": { "patterns": [{ "include": "#expression" }] },
        "4": { "name": "keyword.operator.domain.tape" },
        "5": { "name": "entity.name.namespace.domain.tape" },
        "6": { "name": "punctuation.definition.grade.begin.tape" },
        "7": { "patterns": [{ "include": "#grade" }] },
        "8": { "name": "punctuation.definition.grade.end.tape" }
      }
    },
    "grade": {
      "patterns": [
        {
          "match": "\\b(ok|err|denied|cancelled|partial|superseded)\\b",
          "name": "keyword.other.delivery-state.tape"
        },
        {
          "match": "\\b(required|recommended|optional|draft|active|deprecated)\\b",
          "name": "keyword.other.governance-state.tape"
        },
        {
          "match": "(allow|deny):[^\\s\\]]+",
          "name": "keyword.other.scope.tape"
        },
        {
          "match": "\\b(T\\d+)\\b",
          "name": "constant.numeric.turn-index.tape"
        },
        {
          "match": "\\b(N\\d+)\\b",
          "name": "constant.numeric.wall-clock.tape"
        },
        {
          "match": "d=\\d{4}-\\d{2}-\\d{2}",
          "name": "constant.numeric.date.tape"
        },
        {
          "match": "v=[\\w.]+",
          "name": "constant.numeric.version.tape"
        },
        {
          "comment": "open tag-bag (v1.6): tier-N verification/reuse tier",
          "match": "\\btier-\\d+\\b",
          "name": "constant.numeric.tier.tape"
        },
        {
          "comment": "open tag-bag (v1.6): domain-specific key=value grade tag, e.g. slug= group=",
          "match": "\\b([a-z][a-z0-9-]*)(=)([^\\s\\]]+)",
          "captures": {
            "1": { "name": "variable.parameter.grade.tape" },
            "2": { "name": "keyword.operator.assignment.tape" },
            "3": { "name": "string.unquoted.tape" }
          }
        }
      ]
    },
    "edge-line": {
      "patterns": [
        {
          "match": "^(\\s+)(<-|->|=>|==|~>|\\|>|!!|<:|:>|\\?>|!>|@>)(\\s+)(.*)$",
          "captures": {
            "2": { "name": "keyword.operator.edge.tape" },
            "4": { "patterns": [{ "include": "#expression" }] }
          }
        },
        {
          "match": "^(\\s+)(\".*\")\\s*$",
          "captures": {
            "2": { "name": "string.quoted.double.prose.tape" }
          }
        }
      ]
    },
    "field-line": {
      "match": "^(\\s+)([a-z][A-Za-z0-9_-]*)(\\s*)(=)(\\s*)(.*)$",
      "captures": {
        "2": { "name": "variable.parameter.field.tape" },
        "4": { "name": "keyword.operator.assignment.tape" },
        "6": { "patterns": [{ "include": "#expression" }] }
      }
    },
    "roster-row": {
      "comment": "DOMAINS.tape :: index named-type rows, e.g. `@domain BRAIN := \"./BRAIN.md\"` (no :: kind, no grade)",
      "match": "^(@[a-z][A-Za-z-]*)\\s+(\\S+)\\s+(:=)\\s+(.*)$",
      "captures": {
        "1": { "name": "keyword.control.type.tape" },
        "2": { "name": "entity.name.event.tape" },
        "3": { "name": "keyword.operator.assignment.tape" },
        "4": { "patterns": [{ "include": "#expression" }] }
      }
    },
    "expression": {
      "patterns": [
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#kv-pair" },
        { "include": "#operator" },
        { "include": "#identifier" }
      ]
    },
    "string": {
      "name": "string.quoted.double.tape",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.tape", "match": "\\\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.tape",
      "match": "-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?"
    },
    "kv-pair": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)(=)([^\\s,]+)",
      "captures": {
        "1": { "name": "variable.parameter.tape" },
        "2": { "name": "keyword.operator.assignment.tape" },
        "3": { "name": "string.unquoted.tape" }
      }
    },
    "operator": {
      "name": "keyword.operator.arithmetic.tape",
      "match": "[+\\-*/^=()]"
    },
    "identifier": {
      "name": "variable.other.tape",
      "match": "[A-Za-z_][A-Za-z0-9_]*"
    }
  }
}
