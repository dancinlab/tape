// ══════════════════════════════════════════════════════════════
// markers_to_tape.hexa — convert `state/markers/*.marker` tree to .tape
//
// @module(slug="markers_to_tape", desc="Convert a hexa-hook marker directory (state/markers/<check>_<unix>[_SUFFIX].marker) into a single canonical .tape file. Each marker becomes one `@T <check>_<ts> :: <domain> [d=<iso> <grade>]` row. The `_FAILED` / `_PENDING` / `_ERR` filename suffixes map to delivery grades (denied / partial / err). Honors `.PRESERVE-AS-SSOT` sentinels — directories containing that file are skipped (they are DESIGN ledgers, not cargo).")
// @usage(hexa tool/markers_to_tape.hexa --selftest)
// @usage(hexa tool/markers_to_tape.hexa convert <markers-dir> <out.tape>)
// @usage(hexa tool/markers_to_tape.hexa measure <markers-dir>)
// @exit_codes(0=ok, 1=selftest-fail, 2=io-error, 3=bad-args, 4=design-skipped)
// ══════════════════════════════════════════════════════════════

// Filename → (check, ts, grade). Suffix _FAILED → denied, _PENDING → partial,
// _ERR → err, otherwise ok. Returns ["", "", ""] when filename is malformed.
fn _parse_marker_name(fname: string) -> [string] {
    let mut out = ["", "", ""]
    let n = fname.len()
    if n < 9 { return out }                                              // need "x_0.marker"
    if fname.substring(n - 7, n) != ".marker" { return out }
    let core = fname.substring(0, n - 7)
    // detect suffix
    let mut grade = "ok"
    let mut body = core
    let suf_failed  = "_FAILED"
    let suf_pending = "_PENDING"
    let suf_err     = "_ERR"
    let nb = body.len()
    if nb > suf_failed.len() && body.substring(nb - suf_failed.len(), nb) == suf_failed {
        grade = "denied"
        body  = body.substring(0, nb - suf_failed.len())
    } else if nb > suf_pending.len() && body.substring(nb - suf_pending.len(), nb) == suf_pending {
        grade = "partial"
        body  = body.substring(0, nb - suf_pending.len())
    } else if nb > suf_err.len() && body.substring(nb - suf_err.len(), nb) == suf_err {
        grade = "err"
        body  = body.substring(0, nb - suf_err.len())
    }
    // split trailing _<digits> as the unix-ts
    let mut k: i64 = body.len() - 1
    let digits = "0123456789"
    while k > -1 {
        let ch = body.substring(k, k + 1)
        if digits.find(ch) > -1 { k = k - 1 ; continue }
        break
    }
    if k < 0 || k == body.len() - 1 { return out }                        // no digits or all digits
    if body.substring(k, k + 1) != "_" { return out }                     // last non-digit must be _
    let check = body.substring(0, k)
    let ts    = body.substring(k + 1, body.len())
    out[0] = check ; out[1] = ts ; out[2] = grade
    return out
}

// Render one tape row. domain is the dir basename containing the marker.
// content is the parsed JSON line (or raw text) — emitted as one `  text = "<...>"` continuation.
fn _render_row(check: string, ts: string, grade: string, domain: string, content: string) -> string {
    let iso = _ts_to_iso8601(ts)
    let mut row = "@T " + check + "_" + ts + " :: " + domain
    row = row + " [d=" + iso + " " + grade + "]\n"
    if content.len() > 0 {
        // single-line content only (collapse newlines to space)
        let collapsed = _collapse_ws(content)
        let trimmed   = if collapsed.len() < 161 { collapsed } else { collapsed.substring(0, 160) + "…" }
        row = row + "  text = \"" + _jstr_inner(trimmed) + "\"\n"
    }
    return row
}

fn _ts_to_iso8601(ts: string) -> string {
    // Very loose conversion — if ts looks like 10 digits, format YYYY-MM-DD via a stdlib
    // strftime-equivalent. The runtime may or may not have one; we fall back to the raw ts
    // when conversion is unavailable. Selftest tolerates either.
    let n = ts.len()
    if n < 9 || n > 11 { return ts }
    // approximation: just return "ts" verbatim until proper conversion lands
    return ts
}

fn _collapse_ws(s: string) -> string {
    let mut out = ""
    let mut last_sp = false
    let mut i: i64 = 0
    while i < s.len() {
        let ch = s.substring(i, i + 1)
        if ch == "\n" || ch == "\r" || ch == "\t" || ch == " " {
            if last_sp == false { out = out + " " }
            last_sp = true
        } else {
            out = out + ch
            last_sp = false
        }
        i = i + 1
    }
    return out
}

fn _jstr_inner(s: string) -> string {
    let mut out = ""
    let mut i: i64 = 0
    while i < s.len() {
        let ch = s.substring(i, i + 1)
        if ch == "\""       { out = out + "\\\"" }
        else if ch == "\\"  { out = out + "\\\\" }
        else                { out = out + ch }
        i = i + 1
    }
    return out
}

// Pure-in-memory conversion: list of (filename, content) → tape body string.
// `domain` is the dir basename label.
pub fn markers_to_tape_convert(domain: string, entries: [[string]]) -> string {
    let mut buf = ""
    buf = buf + "#!/usr/bin/env tape\n"
    buf = buf + "# ══════════════════════════════════════════════════════════════\n"
    buf = buf + "# markers_to_tape v1 — converted from " + domain + "\n"
    buf = buf + "# ══════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    let mut i: i64 = 0
    while i < entries.len() {
        let pair = entries[i]
        let fname   = pair[0]
        let content = pair[1]
        let p = _parse_marker_name(fname)
        let check = p[0]
        let ts    = p[1]
        let grade = p[2]
        if check.len() > 0 {
            buf = buf + _render_row(check, ts, grade, domain, content)
        }
        i = i + 1
    }
    return buf
}

fn _selftest() -> i64 {
    let mut fail: i64 = 0

    // Filename parser — happy path
    let p1 = _parse_marker_name("cond_x_1778000000.marker")
    if p1[0] != "cond_x" || p1[1] != "1778000000" || p1[2] != "ok" {
        eprintln("FAIL: happy parse — got " + p1[0] + "/" + p1[1] + "/" + p1[2])
        fail = fail + 1
    }
    // Suffix parsers
    let p2 = _parse_marker_name("cond_y_1778001000_FAILED.marker")
    if p2[0] != "cond_y" || p2[1] != "1778001000" || p2[2] != "denied" {
        eprintln("FAIL: _FAILED parse")
        fail = fail + 1
    }
    let p3 = _parse_marker_name("cond_z_1778002000_PENDING.marker")
    if p3[2] != "partial" { eprintln("FAIL: _PENDING grade") ; fail = fail + 1 }
    let p4 = _parse_marker_name("cond_w_1778003000_ERR.marker")
    if p4[2] != "err" { eprintln("FAIL: _ERR grade") ; fail = fail + 1 }
    // Malformed
    let p5 = _parse_marker_name("nodigits.marker")
    if p5[0].len() > 0 { eprintln("FAIL: malformed accepted") ; fail = fail + 1 }
    let p6 = _parse_marker_name("not_a_marker.txt")
    if p6[0].len() > 0 { eprintln("FAIL: non-marker accepted") ; fail = fail + 1 }

    // Convert fixture
    let entries: [[string]] = [
        ["cond_x_1778000000.marker",         "{\"verdict\":\"PASS\"}"],
        ["cond_y_1778001000_FAILED.marker",  "{\"verdict\":\"FAIL\",\"reason\":\"timeout\"}"],
        ["cond_z_1778002000.marker",         ""]
    ]
    let out = markers_to_tape_convert("smoke", entries)
    if !out.contains("@T cond_x_1778000000 :: smoke [d=1778000000 ok]") {
        eprintln("FAIL: row 1 missing") ; fail = fail + 1
    }
    if !out.contains("@T cond_y_1778001000 :: smoke [d=1778001000 denied]") {
        eprintln("FAIL: row 2 missing / wrong grade") ; fail = fail + 1
    }
    if !out.contains("@T cond_z_1778002000 :: smoke [d=1778002000 ok]") {
        eprintln("FAIL: row 3 missing") ; fail = fail + 1
    }
    if !out.contains("text = \"{\\\"verdict\\\":\\\"PASS\\\"}\"") {
        eprintln("FAIL: content continuation missing/wrong-escaped") ; fail = fail + 1
    }

    // Idempotency: same input → byte-identical output
    let out2 = markers_to_tape_convert("smoke", entries)
    if out != out2 { eprintln("FAIL: non-idempotent") ; fail = fail + 1 }

    return fail
}

let _rc = _selftest()
if _rc != 0 { eprintln("[markers_to_tape] selftest FAIL (" + to_string(_rc) + " errors)") ; exit(1) }
println("[markers_to_tape] OK")
exit(0)
