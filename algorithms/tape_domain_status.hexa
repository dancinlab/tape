// ══════════════════════════════════════════════════════════════
// tape_domain_status.hexa — walk every `<DOMAIN>.md + .tape` pair, print health matrix (v1.1)
//
// @module(slug="tape_domain_status", desc="Scan a directory (default cwd) for `<UPPERCASE>(+<UPPERCASE>)*.md` files following wilson governance principle #4. For each, locate sibling `<DOMAIN>.tape`, count entries by `[ok/err/...]`, find last-entry date, and print a one-screen status matrix. Companion of `wilson domain list` (which only inventories filenames) — `status` adds tape-derived health.")
// @usage(hexa algorithms/tape_domain_status.hexa --selftest)
// @usage(hexa algorithms/tape_domain_status.hexa [<root_dir>])
// @exit_codes(0=ok, 1=selftest-fail, 2=io-error, 3=bad-args)
// ══════════════════════════════════════════════════════════════

fn _is_uppercase_md(name: string) -> bool {
    if name.len() < 4 { return false }
    if name.substring(name.len() - 3, name.len()) != ".md" { return false }
    let bare = name.substring(0, name.len() - 3)
    if bare.len() == 0 { return false }
    let first = bare.substring(0, 1)
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    if upper.find(first) < 0 { return false }
    // every char ∈ [A-Z0-9-+] (allow `+` for meta-domain, `::` would be cross-project — atlas only)
    let allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-+"
    let mut i: i64 = 0
    while i < bare.len() {
        if allowed.find(bare.substring(i, i + 1)) < 0 { return false }
        i = i + 1
    }
    return true
}

fn _is_allowlist(name: string) -> bool {
    if name == "README.md" { return true }
    if name == "CLAUDE.md" { return true }
    if name == "AGENTS.md" { return true }
    if name == "BACKLOG.md" { return true }
    if name == "CLAUDE-CLI-BACKEND.md" { return true }
    return false
}

fn _is_header(line: string) -> bool {
    if line.len() < 2 { return false }
    if line.substring(0, 1) != "@" { return false }
    let known = "SUATRHDKPI?"
    let t = line.substring(1, 2)
    return known.find(t) > -1
}

fn _grade_state(line: string) -> string {
    let lb = line.find("[")
    let rb = line.find("]")
    if lb < 0 || rb < lb { return "" }
    let grade = line.substring(lb + 1, rb)
    let toks = grade.split(" ")
    let mut i: i64 = 0
    while i < toks.len() {
        let t = toks[i]
        if t == "ok"         { return "ok" }
        if t == "err"        { return "err" }
        if t == "denied"     { return "denied" }
        if t == "cancelled"  { return "cancelled" }
        if t == "partial"    { return "partial" }
        if t == "superseded" { return "superseded" }
        i = i + 1
    }
    return ""
}

fn _last_date(body: string) -> string {
    let lines = body.split("\n")
    let mut latest = ""
    let mut i: i64 = 0
    while i < lines.len() {
        let ln = lines[i]
        if _is_header(ln) {
            let lb = ln.find("[")
            let rb = ln.find("]")
            if lb > -1 && rb > lb {
                let grade = ln.substring(lb + 1, rb)
                let toks = grade.split(" ")
                let mut k: i64 = 0
                while k < toks.len() {
                    let tk = toks[k]
                    if tk.len() > 2 && tk.substring(0, 2) == "d=" {
                        let d = tk.substring(2, tk.len())
                        if d > latest { latest = d }
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    return latest
}

// Return [name, kind, total, ok, violated, last_date]
fn _summarize(name: string, tape_body: string) -> [string] {
    let lines = tape_body.split("\n")
    let mut total: i64 = 0
    let mut ok: i64 = 0
    let mut bad: i64 = 0
    let mut i: i64 = 0
    while i < lines.len() {
        let ln = lines[i]
        if _is_header(ln) {
            total = total + 1
            let st = _grade_state(ln)
            if st == "ok" { ok = ok + 1 }
            if st == "err" || st == "denied" || st == "cancelled" { bad = bad + 1 }
        }
        i = i + 1
    }
    let bare = name.substring(0, name.len() - 3)
    let kind = if bare.find("+") > -1 { "meta-domain" } else { "domain" }
    return [bare, kind, str(total), str(ok), str(bad), _last_date(tape_body)]
}

pub fn tape_domain_status_scan(root: string) -> [[string]] {
    let mut rows: [[string]] = []
    let entries = list_dir(root)
    let mut i: i64 = 0
    while i < entries.len() {
        let name = entries[i]
        if !_is_uppercase_md(name) { i = i + 1 ; continue }
        if _is_allowlist(name) { i = i + 1 ; continue }
        let bare = name.substring(0, name.len() - 3)
        let tape_path = root + "/" + bare + ".tape"
        let mut tape_body = ""
        if file_exists(tape_path) { tape_body = fs_read_text(tape_path) }
        rows.push(_summarize(name, tape_body))
        i = i + 1
    }
    return rows
}

fn _render(rows: [[string]]) -> string {
    let mut out = "domain                kind         total   ok    bad   last\n"
    out       = out + "──────────────────────────────────────────────────────────────────\n"
    let mut i: i64 = 0
    while i < rows.len() {
        let r = rows[i]
        let mut name = r[0]
        while name.len() < 22 { name = name + " " }
        let mut kind = r[1]
        while kind.len() < 13 { kind = kind + " " }
        let mut tot = r[2]
        while tot.len() < 8 { tot = tot + " " }
        let mut ok = r[3]
        while ok.len() < 6 { ok = ok + " " }
        let mut bad = r[4]
        while bad.len() < 6 { bad = bad + " " }
        out = out + name + kind + tot + ok + bad + r[5] + "\n"
        i = i + 1
    }
    return out
}

fn _selftest() -> i64 {
    // _is_uppercase_md
    if !_is_uppercase_md("HARNESS.md") { return 1 }
    if !_is_uppercase_md("HARNESS+TOOL+PROVIDER.md") { return 1 }
    if  _is_uppercase_md("readme.md") { return 1 }
    if  _is_uppercase_md("plugins.md") { return 1 }
    if !_is_uppercase_md("BACKLOG.md") { return 1 }   // shape matches; allowlist filters at scan
    if !_is_allowlist("README.md") { return 1 }
    // grade detection
    if _grade_state("@A a001 :: harness [T2 N48 ok]") != "ok" { return 1 }
    if _grade_state("@D d001 deny :: governance [T2 N48 denied]") != "denied" { return 1 }
    // last_date
    let body = "@A a001 :: harness [d=2026-05-12 ok]\n@A a002 :: harness [d=2026-05-13 ok]\n"
    if _last_date(body) != "2026-05-13" { return 1 }
    // summarize
    let sm = _summarize("HARNESS.md", body)
    if sm[0] != "HARNESS" { return 1 }
    if sm[1] != "domain" { return 1 }
    if sm[2] != "2"      { return 1 }
    if sm[3] != "2"      { return 1 }
    if sm[5] != "2026-05-13" { return 1 }
    // render
    let rows: [[string]] = [["HARNESS", "domain", "2", "2", "0", "2026-05-13"]]
    let r = _render(rows)
    if r.find("HARNESS") < 0 { return 1 }
    if r.find("domain") < 0  { return 1 }
    return 0
}

pub fn main() -> i64 {
    let argv = args()
    if argv.len() < 2 { eprintln("usage: tape_domain_status [<root_dir>] | --selftest") ; return 3 }
    let arg1 = argv[1]
    if arg1 == "--selftest" {
        let rc = _selftest()
        if rc == 0 { println("OK: tape_domain_status selftest passed") ; return 0 }
        eprintln("FAIL: tape_domain_status selftest rc=" + str(rc))
        return 1
    }
    let root = arg1
    let rows = tape_domain_status_scan(root)
    println(_render(rows))
    return 0
}
