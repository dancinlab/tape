// ══════════════════════════════════════════════════════════════
// tape_kv_probe.hexa — verify byte-canonical prefix invariance
//
// @module(slug="tape_kv_probe", desc="A KV-cache-stability verifier. Take a tape, take its byte-prefix of length N, assert that re-parsing the prefix yields a strict prefix of the parsed full tape. This is the property that lets a provider's KV cache hit on session resume — same bytes ⇒ same tokens ⇒ same cache key. If a tape passes tape_kv_probe at every prefix boundary, it is KV-cache-stable.")
// @usage(hexa algorithms/tape_kv_probe.hexa --selftest)
// @usage(hexa algorithms/tape_kv_probe.hexa <path>)
// @exit_codes(0=stable, 1=selftest-fail, 2=io-error, 3=bad-args, 4=prefix-drift)
// ══════════════════════════════════════════════════════════════

fn _is_header(line: string) -> bool {
    if line.len() < 2 { return false }
    if line.substring(0, 1) != "@" { return false }
    let known = "SUATRHDKPI?"
    let t = line.substring(1, 2)
    let mut i: i64 = 0
    while i < known.len() {
        if known.substring(i, i + 1) == t { return true }
        i = i + 1
    }
    return false
}

// Count the number of complete event blocks in `body`. A complete block
// = column-0 header line + 0..n continuation lines, terminated by blank
// line OR next column-0 header OR EOF *with* trailing newline.
fn _complete_block_count(body: string) -> i64 {
    let lines = body.split("\n")
    let mut blocks: i64 = 0
    let mut have_header = false
    let mut i: i64 = 0
    while i < lines.len() {
        let ln = lines[i]
        if _is_header(ln) {
            if have_header { blocks = blocks + 1 }
            have_header = true
        }
        i = i + 1
    }
    // Only count the trailing block if the body ends with a newline (so the
    // last block was fully committed to disk).
    if have_header {
        let n = body.len()
        if n > 0 {
            if body.substring(n - 1, n) == "\n" { blocks = blocks + 1 }
        }
    }
    return blocks
}

// True if every prefix that ends at a complete block boundary parses to
// a strict prefix of the full block list.
fn tape_kv_probe_check(body: string) -> bool {
    let lines = body.split("\n")
    let full_blocks = _complete_block_count(body)
    // walk prefix lengths in line increments — cheaper than per-byte
    let mut acc = ""
    let mut prior_blocks: i64 = -1
    let mut i: i64 = 0
    while i < lines.len() {
        if acc.len() > 0 { acc = acc + "\n" }
        acc = acc + lines[i]
        // probe at every "\n" boundary (acc currently has no trailing \n;
        // simulate adding one to check what a flushed prefix would see)
        let with_lf = acc + "\n"
        let pb = _complete_block_count(with_lf)
        if pb < prior_blocks { return false }   // strict monotonicity
        prior_blocks = pb
        if pb > full_blocks { return false }
        i = i + 1
    }
    return true
}

fn _selftest() -> i64 {
    let mut fail: i64 = 0
    let fixture = ""
        + "@S start s001 :: session [T0 N0 ok]\n"
        + "@U u001 = \"hi\" :: harness [T1 N1 ok]\n"
        + "@A a001 :: harness [T1 N2 ok]\n"
        + "  <- u001\n"
        + "@S end :: session [T1 N3 ok]\n"
        + "  ~> s001\n"
    if !tape_kv_probe_check(fixture) {
        eprintln("FAIL: well-formed tape failed kv_probe")
        fail = fail + 1
    }
    // block count check
    let nb = _complete_block_count(fixture)
    if nb != 4 { eprintln("FAIL: expected 4 blocks, got " + to_string(nb)) ; fail = fail + 1 }
    // prefix without trailing newline should report one fewer block
    let truncated = fixture.substring(0, fixture.len() - 1)
    let nbt = _complete_block_count(truncated)
    if nbt != 3 { eprintln("FAIL: truncated tape expected 3 blocks, got " + to_string(nbt)) ; fail = fail + 1 }
    return fail
}

let _rc = _selftest()
if _rc != 0 { eprintln("[tape_kv_probe] selftest FAIL (" + to_string(_rc) + " errors)") ; exit(1) }
println("[tape_kv_probe] OK")
exit(0)
